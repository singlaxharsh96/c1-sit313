# Copy this file to .env and replace the blank values with your Firebase Web App config.
# These VITE_* values are included in the frontend bundle. Never put Admin SDK/private service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
